{
  "version": 2,
  "builds": [
    {
      "src": "package.json",
      "use": "@vercel/static-build",
      "config": {
        "distDir": "dist"
      }
    },
    {
      "src": "api/**/*.js",
      "use": "@vercel/node"
    }
  ],
  "routes": [
    {
      "src": "/api/users(/.*)?",
      "dest": "/api/users/index.js"
    },
    {
      "src": "/api/products/stats/general(/.*)?",
      "dest": "/api/products/stats/general.js"
    },
    {
      "src": "/api/ratings/stats/([^/]+)(/.*)?",
      "dest": "/api/ratings/stats/[productId].js"
    },
    {
      "src": "/api/ratings(/.*)?",
      "dest": "/api/ratings/index.js"
    },
    {
      "src": "/api/products/([^/]+)(/.*)?",
      "dest": "/api/products/[id].js"
    },
    {
      "src": "/api/products(/.*)?",
      "dest": "/api/products/index.js"
    },
    {
      "src": "/pasaronline.png",
      "dest": "/pasaronline.png"
    },
    {
      "src": "/(.*)",
      "dest": "/$1"
    }
  ],
  "env": {
    "NODE_ENV": "production"
  }
}
